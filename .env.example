# Certio — environment configuration.
#
# Copy to .env and fill in the secrets:
#
#     cp .env.example .env
#     certio keygen >> .env      # appends a real master key and JWT secret
#
# Everything here can also live in certio.yaml (see examples/certio.yaml).
# The environment always wins over the file.
#
# .env is gitignored. Never commit real values — the master key is the one
# thing standing between a stolen database and every private key in it.

# === Mode =============================───────────────

# Refuses to boot without a real master key and JWT secret. Leave false only
# for local development, where an ephemeral key is generated on each run — and
# every stored private key becomes unreadable when the process exits.
CERTIO_PRODUCTION=false

# === Secrets (required in production) ────────────────────────────────────────

# Encrypts every stored private key. Generate with `certio keygen`.
# 32 bytes as hex, base64 or raw text.
#
# Back this up somewhere other than the database it protects. Lose it and every
# private key is gone; store it beside the database and the encryption bought
# you nothing.
CERTIO_MASTER_KEY=

# Signs session tokens. Regenerating it only invalidates active sessions.
CERTIO_JWT_SECRET=

# Prefer these in production: a *_FILE path keeps the value out of `ps` output
# and out of container inspect. Set either the value above or the file, not both.
# CERTIO_MASTER_KEY_FILE=/run/secrets/master_key
# CERTIO_JWT_SECRET_FILE=/run/secrets/jwt_secret

# === Server =============================─────────────

CERTIO_HOST=0.0.0.0
CERTIO_PORT=8080

# The externally reachable root. This is baked into the CRL distribution point
# of every certificate issued from now on, so it has to be the URL clients can
# actually resolve — not localhost, once anyone else is using this.
CERTIO_BASE_URL=http://localhost:8080

# Serves the OpenAPI document and the Scalar UI at /docs.
CERTIO_ENABLE_DOCS=true

# Comma-separated. Narrow this if the dashboard is served from another origin.
CERTIO_CORS_ORIGINS=*

# Terminating TLS here is optional; a reverse proxy in front works just as well.
# CERTIO_TLS_CERT=/etc/certio/tls/server.crt
# CERTIO_TLS_KEY=/etc/certio/tls/server.key

# HTTP timeouts, in seconds. Raise the write timeout if you export very large
# bundles over a slow link.
# CERTIO_READ_TIMEOUT=30
# CERTIO_WRITE_TIMEOUT=60
# CERTIO_IDLE_TIMEOUT=120

# === Database =============================───────────

# One value carries the whole database configuration: the scheme picks the
# driver, so nothing else has to be set.
#
#   sqlite:///data/certio.db
#   postgres://certio:secret@db:5432/certio?sslmode=require
#
# A bare path is taken as a SQLite file, so certio.db works as it always has.
CERTIO_DB_URL=certio.db

# A query string on a sqlite: URL is passed through untouched, for tuning the
# pragmas yourself. Without one, Certio sets foreign_keys, busy_timeout and WAL.
# CERTIO_DB_URL=sqlite:///data/certio.db?_pragma=busy_timeout(10000)

# CERTIO_DB_DRIVER, CERTIO_DB_PATH and CERTIO_DB_DSN still work and are still
# read when CERTIO_DB_URL is unset. The URL wins over all three.

# === First administrator =============================

# Creates the initial account on an *empty* database, then never again — so
# restarting the server can never reset credentials. Change the password after
# the first sign-in, or create the account with `certio user create` instead.
#
# Leave the password empty and Certio generates one, logs it once at startup
# and writes it to initial-admin-password.txt in the data directory
# (CERTIO_DATA_DIR, defaulting to the directory holding the SQLite database).
# An empty email defaults to admin@example.com.
CERTIO_ADMIN_EMAIL=admin@example.com
CERTIO_ADMIN_PASSWORD=change-this-immediately
CERTIO_ADMIN_NAME=Administrator

# === Security =============================

# How often a private key may be downloaded through the API or dashboard:
#   always — no limit
#   once   — exactly one download per certificate, then never again
#   never  — private keys are never exposed
# Every attempt is audited either way, including the denials.
CERTIO_KEY_DOWNLOAD_POLICY=always

# Certio keeps no token denylist, so the access token's lifetime is what
# bounds a leaked session. An hour is the default: long enough not to expire
# mid-task, short enough to matter.
CERTIO_ACCESS_TOKEN_TTL=1h
CERTIO_REFRESH_TOKEN_TTL=168h
CERTIO_JWT_ISSUER=certio

# Applied to /auth/login only.
CERTIO_LOGIN_RATE_LIMIT=10
CERTIO_LOGIN_RATE_WINDOW=1m

# === Scheduler =============================──────────

# The in-process worker: expiry scanning, auto-renewal and CRL refresh. With
# this off, nothing renews itself and no expiry notification is ever sent.
CERTIO_SCHEDULER_ENABLED=true
CERTIO_SCHEDULER_INTERVAL=1h
CERTIO_CRL_INTERVAL=24h

# How long a generated CRL stays valid. Keep it comfortably longer than
# CERTIO_CRL_INTERVAL, or clients will see a stale list between refreshes.
# CERTIO_CRL_VALIDITY=168h

# Certificates inside this window are marked "expiring", surface on the
# dashboard and trigger notifications.
CERTIO_EXPIRY_WARN_DAYS=30

# === Issuance defaults =============================──

# Pre-filled on every new certificate and authority. Also editable in the
# dashboard under Settings, which persists them to the database.
CERTIO_DEFAULT_ORGANIZATION=
CERTIO_DEFAULT_COUNTRY=

# ecdsa-p256 | ecdsa-p384 | ecdsa-p521 | rsa-2048 | rsa-3072 | rsa-4096 | ed25519
CERTIO_DEFAULT_KEY_ALGORITHM=ecdsa-p256

# 397 days is the CA/Browser Forum maximum for publicly trusted certificates.
# A private CA may exceed it; staying inside keeps habits portable.
CERTIO_DEFAULT_VALIDITY_DAYS=397
CERTIO_DEFAULT_CA_VALIDITY_DAYS=3650

# === Logging =============================────────────

# debug | info | warning | error | off
CERTIO_LOG_LEVEL=info

# text | json
CERTIO_LOG_FORMAT=text

# Rotated and compressed when set; logs to stdout when empty.
# CERTIO_LOG_FILE=/var/log/certio/certio.log
CERTIO_LOG_CALLER=false

# === CLI-only =============================───────────
#
# These are read by `certio` subcommands rather than the server. They live in
# the environment because a passphrase passed on the command line ends up in
# your shell history. Export them for one command rather than putting them in
# .env, unless the whole file is already protected.
#
# CERTIO_CA_PASSPHRASE=       # unlocks a passphrase-protected CA
# CERTIO_PARENT_PASSPHRASE=   # unlocks the parent when signing an intermediate
# CERTIO_USER_PASSWORD=       # for `certio user create` / `user password`
